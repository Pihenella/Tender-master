NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_URL=

# openai-api uses paid OpenAI API billing. codex-cli uses local `codex exec`
# with your signed-in Codex/ChatGPT account and subscription limits.
AI_PROVIDER=codex-cli

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=xhigh
OPENAI_MAX_OUTPUT_TOKENS=32768
OPENAI_TIMEOUT_MS=600000
OPENAI_MAX_RETRIES=3
OPENAI_EXTRACTION_CHUNK_CHARS=180000

# Optional: choose a specific Codex CLI model. Empty means use Codex config.
CODEX_MODEL=
CODEX_COMMAND=codex
